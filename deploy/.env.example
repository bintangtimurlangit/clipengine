# Sample environment for `docker compose -f deploy/compose.yaml up`.
# Copy to `deploy/.env` and edit before bringing the stack up.
#
#   cp deploy/.env.example deploy/.env
#   # then `openssl rand -hex 32` and paste below
#   docker compose -f deploy/compose.yaml up -d

# Public URL the browser uses to reach the web app. Used for OAuth
# callbacks, cookie domains, and CORS. Use https://… behind a TLS
# reverse proxy.
CLIPENGINE_PUBLIC_URL=http://localhost:3000

# Long random string used by Better Auth to sign session cookies.
# Generate with: openssl rand -hex 32
CLIPENGINE_AUTH_SECRET=

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Host port the web UI binds to. Change if 3000 is taken.
CLIPENGINE_HOST_PORT=3000
