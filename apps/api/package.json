{
  "name": "@clipengine/api",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@clipengine/core": "workspace:*",
    "@clipengine/db": "workspace:*",
    "@clipengine/llm-providers": "workspace:*",
    "@clipengine/schemas": "workspace:*",
    "@clipengine/search-providers": "workspace:*",
    "@better-auth/drizzle-adapter": "1.6.11",
    "@hono/node-server": "1.13.7",
    "better-auth": "1.6.11",
    "hono": "4.6.14",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@clipengine/tsconfig": "workspace:*",
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  }
}
