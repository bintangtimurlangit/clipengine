{
  "name": "clipengine",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted video clipper. Long videos in, long-form and short-form clips out.",
  "author": "Bintang Timurlangit <btimurlangit@gmail.com>",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/bintangtimurlangit/clipengine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bintangtimurlangit/clipengine.git"
  },
  "bugs": {
    "url": "https://github.com/bintangtimurlangit/clipengine/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "turbo": "2.9.14",
    "typescript": "5.7.3"
  }
}
